generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id @default(cuid())
  agencySlug   String    @default("streamersfederation")
  name         String
  email        String
  passwordHash String
  role         String    @default("manager") // admin | manager
  position     String?   // puesto: administracion | mentor | reclutador | creador (define sus tareas fijas)
  canViewAll   Boolean   @default(false) // el admin le dio permiso de ver todos los creadores (no solo los suyos)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  creators     Creator[] @relation("ManagerCreators")
  tasks        Task[]    @relation("TaskAssignee")

  @@unique([agencySlug, email])
  @@index([agencySlug])
}

model Creator {
  id               String           @id @default(cuid())
  agencySlug       String           @default("streamersfederation")
  name             String
  phone            String
  niche            String
  joinDate         DateTime
  tiktokUser       String?
  country          String?          @default("MX")
  status           String           @default("activo") // activo | pausado | baja
  groupName        String?
  notes            String?
  diamonds         Int              @default(0)
  livecoinsStatus  String           @default("pendiente") // pendiente | habilitada | contactado | no_quiere
  livecoinsComment String?
  managerId        String?
  manager          User?            @relation("ManagerCreators", fields: [managerId], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  metrics          Metric[]
  schedules        LiveSchedule[]
  tasks            Task[]
  campaigns        CampaignCreator[]
  settlements      Settlement[]
  contracts        Contract[]
  diamondLogs      DiamondControl[]
  goals            CreatorGoal[]
  noteLog          CreatorNote[]
  portalToken      CreatorPortalToken?

  @@index([agencySlug])
  @@index([agencySlug, status])
}

model DiamondControl {
  id         String   @id @default(cuid())
  agencySlug String   @default("streamersfederation")
  period     String // YYYY-MM
  username   String
  diamonds   Int      @default(0)
  hours      Float    @default(0)
  days       Int      @default(0)
  notes      String?
  creatorId  String?
  creator    Creator? @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([agencySlug, period, username])
  @@index([agencySlug, period])
}

model MonthlyDiamondGoal {
  id         String   @id @default(cuid())
  agencySlug String   @default("streamersfederation")
  period     String // YYYY-MM
  target     Int      @default(0)
  updatedBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([agencySlug, period])
  @@index([agencySlug])
}

model ManagerMonthlyGoal {
  id         String   @id @default(cuid())
  agencySlug String   @default("streamersfederation")
  period     String
  managerId  String
  target     Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([agencySlug, period, managerId])
  @@index([agencySlug, period])
}

model Metric {
  id          String   @id @default(cuid())
  creatorId   String
  creator     Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  date        DateTime
  diamonds    Int      @default(0)
  hoursLive   Float    @default(0)
  peakViewers Int      @default(0)
  battles     Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())

  @@index([creatorId, date])
}

model LiveSchedule {
  id          String   @id @default(cuid())
  creatorId   String
  creator     Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  startAt     DateTime
  durationMin Int      @default(120)
  notes       String?
  status      String   @default("planeado") // planeado | cumplido | faltó | cancelado
  createdAt   DateTime @default(now())

  @@index([startAt])
}

model Task {
  id          String    @id @default(cuid())
  agencySlug  String    @default("streamersfederation")
  title       String
  description String?
  creatorId   String?
  creator     Creator?  @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  assigneeId  String?
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  priority    String    @default("media") // baja | media | alta
  status      String    @default("pendiente") // pendiente | en_progreso | hecha
  period      String    @default("") // YYYY-MM
  dueDate     DateTime?
  templateId  String?
  template    TaskTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  genKey      String? // fecha (YYYY-MM-DD) de la que se generó, para no repetirla
  evidencePath String? // ruta de la foto en el almacenamiento (bucket task-evidence)
  evidenceNote String?
  evidenceAt   DateTime?
  reviewedAt   DateTime? // el admin la aprobó
  reviewNote   String? // motivo si el admin la devolvió
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([templateId, assigneeId, genKey])
  @@index([agencySlug])
  @@index([agencySlug, period])
  @@index([assigneeId, status])
}

model Campaign {
  id             String            @id @default(cuid())
  agencySlug     String            @default("streamersfederation")
  name           String
  description    String?
  startDate      DateTime
  endDate        DateTime
  targetDiamonds Int               @default(0)
  targetHours    Float             @default(0)
  status         String            @default("activa") // activa | finalizada | borrador
  createdAt      DateTime          @default(now())
  creators       CampaignCreator[]

  @@index([agencySlug])
}

model CampaignCreator {
  id               String   @id @default(cuid())
  campaignId       String
  campaign         Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creatorId        String
  creator          Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  progressDiamonds Int      @default(0)
  progressHours    Float    @default(0)

  @@unique([campaignId, creatorId])
}

model Settlement {
  id            String   @id @default(cuid())
  agencySlug    String   @default("streamersfederation")
  creatorId     String
  creator       Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  month         String // YYYY-MM
  diamonds      Int      @default(0)
  hours         Float    @default(0)
  days          Int      @default(0)
  estimatedPay  Float    @default(0) // bono USD
  agencyPercent Float    @default(0)
  agencyAmount  Float    @default(0) // ganancia agencia por creador
  creatorAmount Float    @default(0) // alias bono (mismo que estimatedPay)
  status        String   @default("pendiente") // pendiente | pagado
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([creatorId, month])
  @@index([agencySlug])
  @@index([agencySlug, month])
}

model Contract {
  id         String    @id @default(cuid())
  agencySlug String    @default("streamersfederation")
  creatorId  String
  creator    Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title      String
  status     String    @default("activo") // borrador | activo | vencido | cancelado
  startDate  DateTime?
  endDate    DateTime?
  fileUrl    String?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([agencySlug])
}

// Bonos del mes (antes Firebase)
model BonoRecord {
  id              String    @id @default(cuid())
  agencySlug      String    @default("streamersfederation")
  period          String // YYYY-MM
  nombre          String
  diamantes       Int       @default(0)
  horas           Float     @default(0)
  dias            Int       @default(0)
  bono            Float     @default(0)
  gananciaAgencia Float     @default(0)
  pagado          Boolean   @default(false)
  pagadoAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([agencySlug, period])
  @@index([agencySlug, period, nombre])
}

// Envío de KPI del mes (antes Firebase)
model KpiRecord {
  id         String   @id @default(cuid())
  agencySlug String   @default("streamersfederation")
  period     String // YYYY-MM
  nombre     String
  whatsapp   String   @default("")
  diamantes  Int      @default(0)
  horas      Float    @default(0)
  dias       Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([agencySlug, period])
  @@index([agencySlug, period, nombre])
}

model CreatorGoal {
  id             String   @id @default(cuid())
  agencySlug     String   @default("streamersfederation")
  creatorId      String
  creator        Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  period         String
  targetDiamonds Int      @default(0)
  targetHours    Float    @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([creatorId, period])
  @@index([agencySlug, period])
}

model CreatorNote {
  id         String   @id @default(cuid())
  creatorId  String
  creator    Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  authorId   String?
  authorName String   @default("")
  body       String
  createdAt  DateTime @default(now())

  @@index([creatorId, createdAt])
}

model DiamondImportLog {
  id         String   @id @default(cuid())
  agencySlug String   @default("streamersfederation")
  period     String
  userId     String?
  userName   String   @default("")
  filename   String?
  upserted   Int      @default(0)
  skipped    Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([agencySlug, period])
}

model WaTemplate {
  id         String   @id @default(cuid())
  agencySlug String   @default("streamersfederation")
  name       String
  body       String
  createdAt  DateTime @default(now())

  @@index([agencySlug])
}

model RecruitmentLead {
  id              String    @id @default(cuid())
  agencySlug      String    @default("streamersfederation")
  recruiter       String    @default("")
  managerId       String?
  requestDate     DateTime?
  year            Int?
  month           Int?
  creatorName     String
  situation       String    @default("")
  phone           String    @default("")
  comment         String    @default("")
  comment2        String    @default("")
  recontact       String    @default("")
  integrationDate DateTime?
  steps           Json      @default("{}")
  extra           Json      @default("{}") // valores de las columnas que agrega el admin
  rowColor        String? // color con el que se pinta la fila completa (#RRGGBB)
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([agencySlug, year])
  @@index([agencySlug, month])
  @@index([agencySlug, managerId])
  @@index([agencySlug, recruiter])
}

model ManagerShift {
  id          String   @id @default(cuid())
  agencySlug  String   @default("streamersfederation")
  weekStart   String
  day         Int
  hour        Int
  managerId   String?
  managerName String   @default("")
  label       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([agencySlug, weekStart, day, hour])
  @@index([agencySlug, weekStart])
}

model OnboardingUser {
  id               String   @id @default(cuid())
  agencySlug       String   @default("streamersfederation")
  creatorName      String
  phone            String   @default("")
  situation        String   @default("capacitación")
  integrationMonth String   @default("")
  year             Int?
  month            Int?
  managerId        String?
  managerName      String   @default("")
  checks           Json     @default("{}")
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([agencySlug, year, month])
  @@index([agencySlug, creatorName])
}

model OneOnOneCall {
  id          String   @id @default(cuid())
  agencySlug  String   @default("streamersfederation")
  date        String
  year        Int
  month       Int
  slot        String
  creatorName String   @default("")
  top         String   @default("")
  reason      String   @default("")
  needF       String   @default("")
  needO       String   @default("")
  needD       String   @default("")
  needA       String   @default("")
  managerId   String?
  managerName String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([agencySlug, date, slot])
  @@index([agencySlug, year, month])
}

model BattleGraduation {
  id          String   @id @default(cuid())
  agencySlug  String   @default("streamersfederation")
  year        Int
  month       Int
  columnKey   String
  creatorName String
  note        String   @default("")
  color       String   @default("none")
  done        Boolean  @default(false)
  sortOrder   Int      @default(0)
  managerName String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([agencySlug, year, month])
}

model VideoSuggestion {
  id                String   @id @default(cuid())
  agencySlug        String   @default("streamersfederation")
  date              DateTime
  year              Int
  month             Int
  contentType       String   @default("VIDEO")
  contentIdea       String   @default("")
  objective         String   @default("")
  suggestedBy       String   @default("")
  videoUrl          String   @default("")
  boostRequest      String   @default("NO")
  managerToCreate   String   @default("")
  managerToCreateId String?
  replicateMode     String   @default("SOLO MANAGERS")
  replicateCreators String   @default("")
  videoCreated      String   @default("AUN NO")
  script            String   @default("")
  createdById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([agencySlug, year, month])
}

model OfficialBattle {
  id          String   @id @default(cuid())
  agencySlug  String   @default("streamersfederation")
  year        Int
  month       Int
  date        DateTime
  time        String   @default("")
  level       String   @default("Inicial")
  creatorA    String   @default("")
  agencyA     String   @default("")
  creatorB    String   @default("")
  agencyB     String   @default("")
  boosters    String   @default("NO")
  sortOrder   Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([agencySlug, year, month])
}

model CreatorPortalToken {
  id         String   @id @default(cuid())
  agencySlug String   @default("streamersfederation")
  creatorId  String   @unique
  creator    Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  token      String   @unique @default(cuid())
  createdAt  DateTime @default(now())

  @@index([agencySlug])
}

/// Tarea fija de un puesto: se repite sola (diaria, semanal o mensual) y llega a "Mi día" de cada persona con ese puesto.
model TaskTemplate {
  id           String   @id @default(cuid())
  agencySlug   String   @default("streamersfederation")
  position     String // administracion | mentor | reclutador | creador
  title        String
  description  String?
  priority     String   @default("media") // baja | media | alta
  recurrence   String   @default("diaria") // diaria | semanal | mensual
  weekdays     String   @default("1,2,3,4,5") // 1=lunes … 7=domingo
  dayOfMonth   Int? // para mensual
  dueTime      String? // HH:MM, informativo
  evidenceHint String?
  isPreset     Boolean  @default(false)
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tasks        Task[]

  @@unique([agencySlug, position, title])
  @@index([agencySlug, position, active])
}

/// Evento del calendario mensual del equipo (una celda de la hoja: subasta, entrega de videos, junta…).
model CalendarEvent {
  id         String   @id @default(cuid())
  agencySlug String   @default("streamersfederation")
  date       String // YYYY-MM-DD
  time       String? // HH:MM
  title      String
  notes      String?
  color      String   @default("azul") // azul | verde | rojo | amarillo | morado
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([agencySlug, date])
}

/// Nota de cada mes (por ejemplo la tarea mensual y lo que debe estar listo).
model CalendarMonthNote {
  id         String   @id @default(cuid())
  agencySlug String   @default("streamersfederation")
  month      String // YYYY-MM
  note       String
  updatedAt  DateTime @updatedAt

  @@unique([agencySlug, month])
}

/// Premio calculado de un creador en un mes, del sistema de niveles y bonos (E, D, C, B, A).
/// Se llega por username (el mismo de Control de diamantes) para incluir también a quien aún no está vinculado a un creador.
model BonusAward {
  id           String    @id @default(cuid())
  agencySlug   String    @default("streamersfederation")
  period       String // YYYY-MM del que salen las métricas
  username     String
  creatorId    String?
  kind         String // horas | diamantes | incorporacion2
  tier         String // Bajo, Expectativa, Normal… / Básico, Superior…
  level        String // E | D | C | B | A al calcularlo
  coins        Int       @default(0)
  usd          Float? // equivalente en dólares (niveles B y A)
  advisory     Boolean   @default(false) // el premio es asesoría (no monedas)
  status       String    @default("calculado") // calculado | programado | pagado | acumulado
  scheduledFor String? // YYYY-MM-DD
  method       String? // batalla | live_normal | tiktok_shop | transferencia
  paidAt       DateTime?
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([agencySlug, period, username, kind])
  @@index([agencySlug, period])
  @@index([agencySlug, status])
}

/// Bono de incorporación #1 (regalo de bienvenida): se marca a mano porque depende de 3 transmisiones válidas de 45 min.
model BonusWelcome {
  id          String    @id @default(cuid())
  agencySlug  String    @default("streamersfederation")
  username    String
  reward      String // osito | cofres
  deliveredAt DateTime  @default(now())
  note        String?

  @@unique([agencySlug, username])
}

/// Nivel fijado a mano por el admin para un creador, válido desde un mes en adelante (hasta quitarlo).
model BonusLevelOverride {
  id         String   @id @default(cuid())
  agencySlug String   @default("streamersfederation")
  username   String
  level      String // E | D | C | B | A
  fromPeriod String // YYYY-MM desde el que aplica
  updatedAt  DateTime @updatedAt

  @@unique([agencySlug, username])
}

/// Columnas de la hoja de reclutamiento: las de siempre (builtin) y las que agrega el admin. Define orden, tipo y si se ven.
model RecruitmentColumn {
  id         String   @id @default(cuid())
  agencySlug String   @default("streamersfederation")
  key        String // llave del dato (las de siempre usan la misma de antes)
  label      String
  type       String   @default("text") // text | date | number | check | select
  options    String? // para tipo select: opciones separadas por coma
  sortOrder  Int      @default(0)
  hidden     Boolean  @default(false)
  builtin    Boolean  @default(false)
  color      String? // color del encabezado en hex (#RRGGBB); vacío = el de siempre
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([agencySlug, key])
  @@index([agencySlug, sortOrder])
}

/// Reglas de la pestaña Seguimiento de reclutamiento: qué casillas son obligatorias y cuántos días dura una solicitud.
model RecruitmentSettings {
  id           String   @id @default(cuid())
  agencySlug   String   @default("streamersfederation")
  expiryMode   String   @default("fixed") // fixed (días desde la solicitud) | column (columna Días para que venza) | off
  validityDays Int      @default(7)
  soonDays     Int      @default(2) // "vence pronto" = faltan este número de días o menos
  // Casillas que deben llenarse hasta la integración (llaves de columna separadas por coma)
  requiredKeys String   @default("atendio,situation,seEnvioInvitacion,mensaje,comment,phone,visitarLive,integracion,mensajeAceptacion,mensajeImagen,comment2,integrationDate")
  updatedAt    DateTime @updatedAt

  @@unique([agencySlug])
}
