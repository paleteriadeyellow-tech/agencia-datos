generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id @default(cuid())
  agencySlug   String    @default("streamersfederation")
  name         String
  email        String
  passwordHash String
  role         String    @default("manager") // admin | manager
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  creators     Creator[] @relation("ManagerCreators")
  tasks        Task[]    @relation("TaskAssignee")

  @@unique([agencySlug, email])
  @@index([agencySlug])
}

model Creator {
  id               String           @id @default(cuid())
  agencySlug       String           @default("streamersfederation")
  name             String
  phone            String
  niche            String
  joinDate         DateTime
  tiktokUser       String?
  country          String?          @default("MX")
  status           String           @default("activo") // activo | pausado | baja
  groupName        String?
  notes            String?
  diamonds         Int              @default(0)
  livecoinsStatus  String           @default("pendiente") // pendiente | habilitada | contactado | no_quiere
  livecoinsComment String?
  managerId        String?
  manager          User?            @relation("ManagerCreators", fields: [managerId], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  metrics          Metric[]
  schedules        LiveSchedule[]
  tasks            Task[]
  campaigns        CampaignCreator[]
  settlements      Settlement[]
  contracts        Contract[]
  diamondLogs      DiamondControl[]
  goals            CreatorGoal[]
  noteLog          CreatorNote[]
  portalToken      CreatorPortalToken?

  @@index([agencySlug])
  @@index([agencySlug, status])
}

model DiamondControl {
  id         String   @id @default(cuid())
  agencySlug String   @default("streamersfederation")
  period     String // YYYY-MM
  username   String
  diamonds   Int      @default(0)
  hours      Float    @default(0)
  days       Int      @default(0)
  notes      String?
  creatorId  String?
  creator    Creator? @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([agencySlug, period, username])
  @@index([agencySlug, period])
}

model MonthlyDiamondGoal {
  id         String   @id @default(cuid())
  agencySlug String   @default("streamersfederation")
  period     String // YYYY-MM
  target     Int      @default(0)
  updatedBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([agencySlug, period])
  @@index([agencySlug])
}

model ManagerMonthlyGoal {
  id         String   @id @default(cuid())
  agencySlug String   @default("streamersfederation")
  period     String
  managerId  String
  target     Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([agencySlug, period, managerId])
  @@index([agencySlug, period])
}

model Metric {
  id          String   @id @default(cuid())
  creatorId   String
  creator     Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  date        DateTime
  diamonds    Int      @default(0)
  hoursLive   Float    @default(0)
  peakViewers Int      @default(0)
  battles     Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())

  @@index([creatorId, date])
}

model LiveSchedule {
  id          String   @id @default(cuid())
  creatorId   String
  creator     Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  startAt     DateTime
  durationMin Int      @default(120)
  notes       String?
  status      String   @default("planeado") // planeado | cumplido | faltó | cancelado
  createdAt   DateTime @default(now())

  @@index([startAt])
}

model Task {
  id          String    @id @default(cuid())
  agencySlug  String    @default("streamersfederation")
  title       String
  description String?
  creatorId   String?
  creator     Creator?  @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  assigneeId  String?
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  priority    String    @default("media") // baja | media | alta
  status      String    @default("pendiente") // pendiente | en_progreso | hecha
  period      String    @default("") // YYYY-MM
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([agencySlug])
  @@index([agencySlug, period])
}

model Campaign {
  id             String            @id @default(cuid())
  agencySlug     String            @default("streamersfederation")
  name           String
  description    String?
  startDate      DateTime
  endDate        DateTime
  targetDiamonds Int               @default(0)
  targetHours    Float             @default(0)
  status         String            @default("activa") // activa | finalizada | borrador
  createdAt      DateTime          @default(now())
  creators       CampaignCreator[]

  @@index([agencySlug])
}

model CampaignCreator {
  id               String   @id @default(cuid())
  campaignId       String
  campaign         Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creatorId        String
  creator          Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  progressDiamonds Int      @default(0)
  progressHours    Float    @default(0)

  @@unique([campaignId, creatorId])
}

model Settlement {
  id            String   @id @default(cuid())
  agencySlug    String   @default("streamersfederation")
  creatorId     String
  creator       Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  month         String // YYYY-MM
  diamonds      Int      @default(0)
  hours         Float    @default(0)
  days          Int      @default(0)
  estimatedPay  Float    @default(0) // bono USD
  agencyPercent Float    @default(0)
  agencyAmount  Float    @default(0) // ganancia agencia por creador
  creatorAmount Float    @default(0) // alias bono (mismo que estimatedPay)
  status        String   @default("pendiente") // pendiente | pagado
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([creatorId, month])
  @@index([agencySlug])
  @@index([agencySlug, month])
}

model Contract {
  id         String    @id @default(cuid())
  agencySlug String    @default("streamersfederation")
  creatorId  String
  creator    Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title      String
  status     String    @default("activo") // borrador | activo | vencido | cancelado
  startDate  DateTime?
  endDate    DateTime?
  fileUrl    String?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([agencySlug])
}

// Bonos del mes (antes Firebase)
model BonoRecord {
  id              String    @id @default(cuid())
  agencySlug      String    @default("streamersfederation")
  period          String // YYYY-MM
  nombre          String
  diamantes       Int       @default(0)
  horas           Float     @default(0)
  dias            Int       @default(0)
  bono            Float     @default(0)
  gananciaAgencia Float     @default(0)
  pagado          Boolean   @default(false)
  pagadoAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([agencySlug, period])
  @@index([agencySlug, period, nombre])
}

// Envío de KPI del mes (antes Firebase)
model KpiRecord {
  id         String   @id @default(cuid())
  agencySlug String   @default("streamersfederation")
  period     String // YYYY-MM
  nombre     String
  whatsapp   String   @default("")
  diamantes  Int      @default(0)
  horas      Float    @default(0)
  dias       Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([agencySlug, period])
  @@index([agencySlug, period, nombre])
}

model CreatorGoal {
  id             String   @id @default(cuid())
  agencySlug     String   @default("streamersfederation")
  creatorId      String
  creator        Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  period         String
  targetDiamonds Int      @default(0)
  targetHours    Float    @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([creatorId, period])
  @@index([agencySlug, period])
}

model CreatorNote {
  id         String   @id @default(cuid())
  creatorId  String
  creator    Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  authorId   String?
  authorName String   @default("")
  body       String
  createdAt  DateTime @default(now())

  @@index([creatorId, createdAt])
}

model DiamondImportLog {
  id         String   @id @default(cuid())
  agencySlug String   @default("streamersfederation")
  period     String
  userId     String?
  userName   String   @default("")
  filename   String?
  upserted   Int      @default(0)
  skipped    Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([agencySlug, period])
}

model WaTemplate {
  id         String   @id @default(cuid())
  agencySlug String   @default("streamersfederation")
  name       String
  body       String
  createdAt  DateTime @default(now())

  @@index([agencySlug])
}

model RecruitmentLead {
  id              String    @id @default(cuid())
  agencySlug      String    @default("streamersfederation")
  recruiter       String    @default("")
  managerId       String?
  requestDate     DateTime?
  year            Int?
  month           Int?
  creatorName     String
  situation       String    @default("")
  phone           String    @default("")
  comment         String    @default("")
  comment2        String    @default("")
  recontact       String    @default("")
  integrationDate DateTime?
  steps           Json      @default("{}")
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([agencySlug, year])
  @@index([agencySlug, month])
  @@index([agencySlug, managerId])
  @@index([agencySlug, recruiter])
}

model ManagerShift {
  id          String   @id @default(cuid())
  agencySlug  String   @default("streamersfederation")
  weekStart   String
  day         Int
  hour        Int
  managerId   String?
  managerName String   @default("")
  label       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([agencySlug, weekStart, day, hour])
  @@index([agencySlug, weekStart])
}

model OnboardingUser {
  id               String   @id @default(cuid())
  agencySlug       String   @default("streamersfederation")
  creatorName      String
  phone            String   @default("")
  situation        String   @default("capacitación")
  integrationMonth String   @default("")
  year             Int?
  month            Int?
  managerId        String?
  managerName      String   @default("")
  checks           Json     @default("{}")
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([agencySlug, year, month])
  @@index([agencySlug, creatorName])
}

model OneOnOneCall {
  id          String   @id @default(cuid())
  agencySlug  String   @default("streamersfederation")
  date        String
  year        Int
  month       Int
  slot        String
  creatorName String   @default("")
  top         String   @default("")
  reason      String   @default("")
  needF       String   @default("")
  needO       String   @default("")
  needD       String   @default("")
  needA       String   @default("")
  managerId   String?
  managerName String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([agencySlug, date, slot])
  @@index([agencySlug, year, month])
}

model BattleGraduation {
  id          String   @id @default(cuid())
  agencySlug  String   @default("streamersfederation")
  year        Int
  month       Int
  columnKey   String
  creatorName String
  note        String   @default("")
  color       String   @default("none")
  done        Boolean  @default(false)
  sortOrder   Int      @default(0)
  managerName String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([agencySlug, year, month])
}

model CreatorPortalToken {
  id         String   @id @default(cuid())
  agencySlug String   @default("streamersfederation")
  creatorId  String   @unique
  creator    Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  token      String   @unique @default(cuid())
  createdAt  DateTime @default(now())

  @@index([agencySlug])
}
